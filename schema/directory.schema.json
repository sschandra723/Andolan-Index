{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "directory.schema.json",
  "title": "Archive directory",
  "description": "Other sites that document protests in depth. We link to them instead of copying them.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "url", "kind", "about"],
    "properties": {
      "name": {"type": "string", "minLength": 2},
      "url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
      "kind": {"type": "string", "minLength": 2},
      "about": {"type": "string", "minLength": 20, "maxLength": 300}
    }
  }
}
